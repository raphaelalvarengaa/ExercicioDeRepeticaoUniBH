    private static void Algoritmo11 (){
        Scanner scanner = new Scanner(System.in);

        System.out.print("Digite o limite inferior (inteiro e positivo): ");
        int limiteInferior = scanner.nextInt();

        System.out.print("Digite o limite superior (inteiro e positivo): ");
        int limiteSuperior = scanner.nextInt();

        int somaPares = 0;

        for (int i = limiteInferior; i <= limiteSuperior; i++) {
            if (i % 2 == 0) {
                somaPares += i;
            }
        }
        System.out.println("RESULTADO");
        System.out.println("A soma de todos os números pares no intervalo [" + limiteInferior + ", " + limiteSuperior + "] é: " + somaPares);

        scanner.close();
    }
