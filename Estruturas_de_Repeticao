    private static void Algoritmo8 (){
        Scanner scanner = new Scanner(System.in);

        final int TOTAL_AMIGOS = 15;

        String nomeMaior = "", nomeMenor = "";
        double maiorAltura = Double.MIN_VALUE;
        double menorAltura = Double.MAX_VALUE;

        double somaAlturaHomens = 0, somaAlturaMulheres = 0, somaAlturaTotal = 0;
        int qtdHomens = 0, qtdMulheres = 0;

        for (int i = 1; i <= TOTAL_AMIGOS; i++) {
            System.out.println("--- Amigo " + i + " de " + TOTAL_AMIGOS + " ---");
            System.out.print("Nome: ");
            String nome = scanner.next();

            System.out.print("Altura (em metros): ");
            double altura = scanner.nextDouble();

            System.out.print("Sexo (1 - Masculino, 2 - Feminino): ");
            int sexo = scanner.nextInt();

            somaAlturaTotal += altura;

            if (altura > maiorAltura) {
                maiorAltura = altura;
                nomeMaior = nome;
            }

            if (altura < menorAltura) {
                menorAltura = altura;
                nomeMenor = nome;
            }

            if (sexo == 1) {
                somaAlturaHomens += altura;
                qtdHomens++;
            } else if (sexo == 2) {
                somaAlturaMulheres += altura;
                qtdMulheres++;
            }

            System.out.println();
        }

        System.out.println("RESULTADO DA ANÁLISE");
        System.out.printf("Maior altura: %.2f m (Nome: ", maiorAltura, nomeMaior);
        System.out.printf("Menor altura: %.2f m (Nome: ", menorAltura, nomeMenor);

        if (qtdHomens > 0) {
            System.out.printf("Média de altura dos homens: ", somaAlturaHomens / qtdHomens);
        } else {
            System.out.println("Nenhum homem cadastrado.");
        }

        if (qtdMulheres > 0) {
            System.out.printf("Média de altura das mulheres: ", somaAlturaMulheres / qtdMulheres);
        } else {
            System.out.println("Nenhuma mulher cadastrada.");
        }

        System.out.printf("Média de altura da turma: ", somaAlturaTotal / TOTAL_AMIGOS);

        scanner.close();
    }
